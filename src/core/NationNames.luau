local oes={["Potato"]=true,["Tomato"]=true,["Volcano"]=true,["Torpedo"]=true}
local special={["Cactus"]="Cacti",["Platypus"]="Platypuses",["Moose"]="Moose",["Octopus"]="Octopi",["Cyclops"]="Cyclopes",["Samurai"]="Samurai",["Fish"]="Fish",["Salmon"]="Salmon",["Cod"]="Cod",["Enderman"]="Endermen",["Mitochondria"]="Mitochondria"}
function M.pluralize(noun)
    if special[noun]then return special[noun]end
    local last=noun:sub(-1);local two=noun:sub(-2)
    if last=="s"or two=="ch"or two=="sh"or last=="x"or last=="z"then return noun.."es"end
    if last=="y"and not string.find("aeiou",noun:sub(-2,-2),1,true)then return noun:sub(1,-2).."ies"end
    if oes[noun]then return noun.."es"end
    return noun.."s"
end
function M.generate(random)
    local template=M.templates[random:nextInt(0,#M.templates)+1];local noun=M.nouns[random:nextInt(0,#M.nouns)+1]
    local parts={};for _,part in ipairs(template)do table.insert(parts,part==P and M.pluralize(noun)or part==N and noun or part)end
    return table.concat(parts," ")
end
function M.unique(random,used)
    for _=1,1000 do local name=M.generate(random);if not used[name]then return name end end
    local base=M.generate(random);local counter=1;while used[base.." "..counter]do counter+=1 end
    return base.." "..counter
end
return M
